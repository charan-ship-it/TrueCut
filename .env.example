# TrueCut configuration. Copy to .env.local and fill in. Never commit the filled-in file.

# Postgres (projects, jobs, users). Local: see docs/DEVELOPMENT.md. Railway: injected by the Postgres plugin.
DATABASE_URL=postgresql://truecut:truecut@localhost:5432/truecut
# Google sign-in (required in production). Create an OAuth client at console.cloud.google.com → Credentials,
# with redirect URI <NEXTAUTH_URL>/api/auth/callback/google. Leave GOOGLE_CLIENT_ID unset locally to skip sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_SECRET=            # openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3100
# ALLOWED_EMAIL_DOMAINS=aixccelerate.com
# ALLOWED_EMAILS=             # extra individual addresses, comma-separated
# TRUECUT_WORKSPACE_NAME=AI Xccelerate

# Who runs background jobs: "inline" (inside the web app, fine for one laptop) or "pgboss" (the worker service).
# TRUECUT_QUEUE=inline

# Claude (analysis + storyboard). Without it, rule-based fallbacks are used.
ANTHROPIC_API_KEY=
# Optional model overrides
# TRUECUT_MODEL=claude-sonnet-4-6
# TRUECUT_CREATIVE_MODEL=claude-opus-4-8

# ElevenLabs (voice-over with word timings). Without it, videos render with music + captions only.
ELEVENLABS_API_KEY=
# Default voice (Sarah). Pick any voice in the app.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Reuse keys that already live in other env files (only ANTHROPIC_API_KEY / ELEVENLABS_* are read):
# TRUECUT_ENV_FILES=../linkedin-nick/.env,../agent-nick/.env.local

# Bucket for project files (sources, screenshots, voice, renders). Leave unset to keep files on local disk.
# Railway's bucket variables (BUCKET, ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION) work as-is too.
# S3_BUCKET=
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# Folder-path sources (read a repo from disk). On by default only with local storage.
# TRUECUT_ALLOW_PATHS=true

# Where projects and renders are stored locally (with a bucket: the working cache). Default ./data
# TRUECUT_DATA=data
# Parallel render workers (default: half your CPU cores, max 6)
# TRUECUT_WORKERS=4
# Use a specific Chromium binary instead of Playwright's
# TRUECUT_CHROMIUM=
