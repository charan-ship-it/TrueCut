# TrueCut configuration. Copy to .env.local and fill in. Never commit the filled-in file.

# Postgres (projects, jobs, users). Local: see docs/DEVELOPMENT.md. Railway: injected by the Postgres plugin.
DATABASE_URL=postgresql://truecut:truecut@localhost:5432/truecut
# Who runs background jobs: "inline" (inside the web app, fine for one laptop) or "pgboss" (the worker service).
# TRUECUT_QUEUE=inline

# Claude (analysis + storyboard). Without it, rule-based fallbacks are used.
ANTHROPIC_API_KEY=
# Optional model overrides
# TRUECUT_MODEL=claude-sonnet-4-6
# TRUECUT_CREATIVE_MODEL=claude-opus-4-8

# ElevenLabs (voice-over with word timings). Without it, videos render with music + captions only.
ELEVENLABS_API_KEY=
# Default voice (Sarah). Pick any voice in the app.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Reuse keys that already live in other env files (only ANTHROPIC_API_KEY / ELEVENLABS_* are read):
# TRUECUT_ENV_FILES=../linkedin-nick/.env,../agent-nick/.env.local

# Where projects and renders are stored (default ./data)
# TRUECUT_DATA=data
# Parallel render workers (default: half your CPU cores, max 6)
# TRUECUT_WORKERS=4
# Use a specific Chromium binary instead of Playwright's
# TRUECUT_CHROMIUM=
