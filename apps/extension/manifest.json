{
  "manifest_version": 3,
  "name": "TrueCut Capture",
  "short_name": "TrueCut",
  "version": "0.5.0",
  "description": "Capture real product screens into your team's TrueCut Library, with blur for personal data.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture to TrueCut",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture the visible area"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Select an area to capture"
    }
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://truecut.up.railway.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
