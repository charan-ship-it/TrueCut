{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["apps/worker/**", "packages/**", "package-lock.json", "Dockerfile", "docker/**"]
  },
  "deploy": {
    "startCommand": "truecut worker",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "drainingSeconds": "300",
    "restartPolicyType": "ALWAYS"
  }
}
