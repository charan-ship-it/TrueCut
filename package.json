{
  "name": "truecut",
  "version": "0.1.0",
  "private": true,
  "description": "Nick Motion \u2014 turn any URL, repo or folder into a fact-checked motion-graphics video ad.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development next dev -p 3100",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start -p 3100",
    "setup": "bash scripts/setup.sh",
    "make": "tsx scripts/make.ts",
    "render": "tsx scripts/render-cli.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "ffmpeg-static": "^5.3.0",
    "image-size": "^2.0.2",
    "nanoid": "^5.1.5",
    "next": "14.2.35",
    "playwright": "^1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
