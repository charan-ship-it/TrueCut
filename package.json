{
  "name": "truecut",
  "version": "0.3.0",
  "private": true,
  "description": "TrueCut \u2014 drop a link, get a film: fact-checked motion videos and founder-talk edits, directed in a conversation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @truecut/web",
    "build": "npm run build -w @truecut/web",
    "start": "npm run start -w @truecut/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "make": "tsx tools/make.ts",
    "render": "tsx tools/render-cli.ts",
    "seed:demo": "tsx tools/seed-demo.ts",
    "doctor": "tsx tools/doctor.ts",
    "setup": "bash tools/setup.sh",
    "db:migrate": "npm run migrate -w @truecut/db",
    "db:generate": "npm run generate -w @truecut/db",
    "db:import": "tsx tools/import-projects.ts",
    "worker": "npm run start -w @truecut/worker",
    "dev:worker": "npm run dev -w @truecut/worker"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
